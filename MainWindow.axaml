<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LogisticsPlanner.MainWindow"
        Title="Logistics Planner"
        Width="800" Height="450">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="MediumSeaGreen"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions = "Auto, Auto, *, Auto" Margin = "20">

        <TextBlock Grid.Row="0" Text="Shipping Cost Calculation" FontSize="24" FontWeight="Bold" Margin="0, 0, 0, 20"/>

        <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock Text ="Weight of the package (kg):"/>
            <NumericUpDown Name="WeightInput" Minimum="0.1" Maximum="100" Value="1" FormatString="0.0"/>

            <TextBlock Text="Delivery zone:"/>
            <ComboBox Name="ZoneInput" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem>EU</ComboBoxItem>
                <ComboBoxItem>Local</ComboBoxItem>
                <ComboBoxItem>USA</ComboBoxItem>
            </ComboBox>

            <Button Name="CalculateBtn" Content="Calculate Cost" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,10"/>
        </StackPanel>

        <DataGrid Name="ResultsGrid" 
                  Grid.Row="2" 
                  Margin="0,20" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  x:CompileBindings="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Carrier" Binding="{Binding CarrierName}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding TotalCost, StringFormat='{}{0} EUR'}" Width="*"/>
                <DataGridTextColumn Header="Delivery Time" Binding="{Binding EstimatedDelivery}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Name="StatusText" Grid.Row="3" Foreground="Gray" FontSize="12"/>
    </Grid>

</Window>
